{
  "name": "jiyue-qipai-desktop",
  "productName": "极跃棋牌",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "极跃棋牌 · 企业级 Electron 桌面客户端",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5175\" \"wait-on http://localhost:5175 && electron .\"",
    "build": "vite build",
    "preview": "vite preview --port 5175",
    "electron:build": "vite build && electron-builder",
    "electron:dir": "vite build && electron-builder --dir"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "pinia": "^2.2.2",
    "socket.io-client": "^4.7.5",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^5.4.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.jiyue.qipai",
    "productName": "极跃棋牌",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "极跃棋牌",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  }
}
