# Node 依赖
node_modules/
**/node_modules/

# 运行时数据与密钥（部署时由服务端重新生成）
server/data/*.json

# 日志
*.log
npm-debug.log*

# 系统临时文件
.DS_Store
Thumbs.db
desktop.ini

# 编译中间产物（源码保留，构建产物不入库）
shell-app/build/
shell-app/IPAShell.xcodeproj/
*.xcarchive

# 演示生成的成品 IPA（可选保留）
# examples/*.ipa

# 含个人访问令牌的本地推送脚本（严禁入库泄露令牌）
一键推送到GitHub.bat
上传GitHub.bat
